---
interface Props {}

interface Project {
  title: string;
  category: string;
  problem: string;
  solution: string;
  tags: string[];
  href: string;
  // + href a demo o video opcional
}

const projects: Project[] = [
  {
    title: "Manual RAG Assistant",
    category: "Backend + AI",
    problem:
      "Los intervalos de mantenimiento de una moto están enterrados en tablas de manuales PDF de cientos de páginas, uno por modelo y año. Un LLM sin fuentes responde de memoria e inventa valores, y además calcula mal, un riesgo real cuando el dato define cuándo hacer un service.",
    solution:
      "Servidor MCP que expone herramientas a cualquier cliente compatible (p. ej. Claude Desktop): búsqueda híbrida (BM25 + embeddings locales + RRF) que devuelve fragmentos con sección y página de origen, extracción de tablas del PDF, y un cálculo determinístico del próximo service sin LLM. El modelo orquesta, pero los datos y las cuentas salen de fuentes verificables.",
    tags: ["Kotlin", "Spring Boot", "Spring AI", "MCP", "Tool Calling", "Lucene (BM25)", "ONNX", "SQLite"],
    href: "https://github.com/SRodriguezSpina/manual-rag-assistant",
  },
  {
    title: "BookLibre",
    category: "Full-Stack Development",
    problem:
      "Trabajo académico: Desarrollar una aplicación web que integre servicios backend, persistencia de datos y una interfaz de usuario para un sistema de préstamos de libros.",
    solution:
      "Desarrollo de servicios backend con Kotlin y Spring Boot, APIs REST y esquemas GraphQL, integrando PostgreSQL y MongoDB para persistencia, Redis para caché y React con TypeScript para el frontend.",
    tags: [
      "Kotlin",
      "Spring Boot",
      "REST API",
      "GraphQL",
      "PostgreSQL",
      "MongoDB",
      "Redis",
      "React",
      "TypeScript",
      "Docker",
    ],
    href: "https://github.com",
  },
  {
    title: "Algo que pedir",
    category: "Full-Stack Development",
    problem:
      "Trabajo académico: desarrollar una aplicación web que permita a los locales gastronómicos gestionar su información y oferta de platos, y a los consumidores personalizar sus preferencias alimentarias.",
    solution:
      "Implementación de lógica de negocio para la gestión de locales, publicación de platos e ingredientes, y administración de preferencias del consumidor, incluyendo locales y platos favoritos, ingredientes preferidos e ingredientes a evitar. Desarrollo de interfaces de usuario con React y TypeScript.",
    tags: [
      "Kotlin",
      "Spring Boot",
      "React",
      "TypeScript",
      "Desarrollo Web",
      "Lógica de Negocio"
    ],
    href: "https://github.com",
  },
];
---

<section
  aria-labelledby="section-proyectos"
  class="flex flex-col gap-space-md px-gutter w-full max-w-4xl mx-auto"
>
  <!-- Encabezado de la sección -->
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2">
      <img src="/icons/folder.svg" alt="Proyectos" class="w-6 h-6" />
      <h2
        id="section-proyectos"
        class="font-mono text-label-md font-medium text-on-surface tracking-tight"
      >
        ~/ proyectos-destacados
      </h2>
    </div>
    <span class="font-mono text-label-xs text-secondary">
      [0{projects.length}/0{projects.length}]
    </span>
  </div>

  <!-- Grilla de proyectos -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-space-md">
    {
      projects.map((project) => (
        <article class="flex flex-col justify-between p-space-md rounded-xl bg-surface-container-lowest border border-border-subtle/40 shadow-sm gap-space-md">
          <!-- Contenido superior -->
          <div class="flex flex-col gap-space-sm">
            <!-- Título y Categoría -->
            <div class="flex flex-col items-start justify-between gap-2">
              <span class="shrink-0 px-2 py-0.5 rounded bg-surface-container-low border border-border-subtle/40 font-mono text-label-xs text-secondary whitespace-nowrap">
                {project.category}
              </span>
              <h3 class="font-sans text-headline-sm text-on-surface font-semibold leading-snug">
                {project.title}
              </h3>
              
            </div>

            <!-- Problema -->
            <div class="flex flex-col gap-1">
              <span class="font-mono text-label-xs text-secondary uppercase tracking-wider font-medium">
                Problema
              </span>
              <p class="font-sans text-body-sm text-on-surface leading-relaxed">
                {project.problem}
              </p>
            </div>

            <!-- Solución Técnica -->
            <div class="flex flex-col gap-1 p-2.5 rounded bg-surface-container-low border border-border-subtle/40">
              <span class="font-mono text-label-xs text-primary uppercase tracking-wider font-medium">
                Solución Técnica
              </span>
              <p class="font-sans text-body-sm text-on-surface leading-relaxed">
                {project.solution}
              </p>
            </div>

            <!-- Conceptos y Stack -->
            <div class="flex flex-col gap-1.5 pt-space-xs">
              <span class="font-mono text-label-xs text-secondary uppercase tracking-wider font-medium">
                Conceptos & Stack
              </span>
              <div class="flex flex-wrap gap-1.5">
                {project.tags.map((tag) => (
                  <span class="px-2 py-0.5 rounded bg-surface/60 text-on-surface font-mono text-label-xs border border-border-subtle/40">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Footer / CTA a GitHub -->
          <div class="pt-space-xs border-t border-border-subtle/40">
            <a
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-center gap-2 py-2 px-3 rounded-lg bg-surface-container-low hover:bg-surface-container border border-border-subtle/40 text-on-surface font-mono text-label-sm font-medium transition-colors"
            >
              <img src="/icons/github-logo.svg" alt="GitHub" class="w-5 h-5" />
              <span>Código fuente en GitHub</span>
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>
