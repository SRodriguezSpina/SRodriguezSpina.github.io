---
interface Props {}

interface Project {
  title: string;
  category: string;
  problem: string;
  solution: string;
  tags: string[];
  href: string;
}

const projects: Project[] = [
  {
    title: "Motor de Facturación y Liquidación Distribuida",
    category: "Sistemas Distribuidos",
    problem:
      "Cuellos de botella y bloqueos en la liquidación financiera con más de 100k transacciones mensuales en bases relacionales monolíticas.",
    solution:
      "Arquitectura asíncrona por eventos con workers concurrentes en Go, colas de mensajería, control de idempotencia transaccional y procesamiento en batches optimizados.",
    tags: ["Go", "PostgreSQL", "RabbitMQ", "Workers", "Event-Driven"],
    href: "https://github.com",
  },
  {
    title: "API de Búsqueda Semántica y RAG Documental",
    category: "RAG & Embeddings",
    problem:
      "Recuperación lenta y baja relevancia en consultas léxicas sobre un repositorio de 50.000 documentos técnicos no estructurados.",
    solution:
      "Pipeline de ingesta incremental con chunking adaptativo, generación de embeddings densos indexados en Qdrant y capa de caché semántico en Redis.",
    tags: ["Python (FastAPI)", "Qdrant", "Redis", "Vector DB", "LangChain"],
    href: "https://github.com",
  },
  {
    title: "Gestor de Reservas con Control de Concurrencia",
    category: "Proyecto Académico",
    problem:
      "Condiciones de carrera y sobre-asignación de cupos durante ráfagas de solicitudes concurrentes en microservicios independientes.",
    solution:
      "Implementación de locks distribuidos mediante Redis (Redlock), validación transaccional con control de versiones optimista y sistema resiliente de webhooks con reintentos exponenciales.",
    tags: [
      "Node.js (NestJS)",
      "TypeScript",
      "PostgreSQL",
      "Distributed Locks",
      "Webhooks",
    ],
    href: "https://github.com",
  },
];
---

<section
  aria-labelledby="section-proyectos"
  class="flex flex-col gap-space-md px-gutter w-full max-w-4xl mx-auto"
>
  <!-- Encabezado de la sección -->
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-lg text-secondary">folder</span>
      <h2
        id="section-proyectos"
        class="font-mono text-label-md font-medium text-on-surface tracking-tight"
      >
        ~/ proyectos-destacados
      </h2>
    </div>
    <span class="font-mono text-label-xs text-secondary">
      [0{projects.length}/0{projects.length}]
    </span>
  </div>

  <!-- Grilla de proyectos -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-space-md">
    {
      projects.map((project) => (
        <article class="flex flex-col justify-between p-space-md rounded-xl bg-surface-container-lowest border border-border-subtle/40 shadow-sm gap-space-md">
          <!-- Contenido superior -->
          <div class="flex flex-col gap-space-sm">
            <!-- Título y Categoría -->
            <div class="flex items-start justify-between gap-2">
              <h3 class="font-sans text-headline-sm text-on-surface font-semibold leading-snug">
                {project.title}
              </h3>
              <span class="shrink-0 px-2 py-0.5 rounded bg-surface-container-low border border-border-subtle/40 font-mono text-label-xs text-secondary whitespace-nowrap">
                {project.category}
              </span>
            </div>

            <!-- Problema -->
            <div class="flex flex-col gap-1">
              <span class="font-mono text-label-xs text-secondary uppercase tracking-wider font-medium">
                Problema
              </span>
              <p class="font-sans text-body-sm text-on-surface leading-relaxed">
                {project.problem}
              </p>
            </div>

            <!-- Solución Técnica -->
            <div class="flex flex-col gap-1 p-2.5 rounded bg-surface-container-low border border-border-subtle/40">
              <span class="font-mono text-label-xs text-primary uppercase tracking-wider font-medium">
                Solución Técnica
              </span>
              <p class="font-sans text-body-sm text-on-surface leading-relaxed">
                {project.solution}
              </p>
            </div>

            <!-- Conceptos y Stack -->
            <div class="flex flex-col gap-1.5 pt-space-xs">
              <span class="font-mono text-label-xs text-secondary uppercase tracking-wider font-medium">
                Conceptos & Stack
              </span>
              <div class="flex flex-wrap gap-1.5">
                {project.tags.map((tag) => (
                  <span class="px-2 py-0.5 rounded bg-surface/60 text-on-surface font-mono text-label-xs border border-border-subtle/40">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Footer / CTA a GitHub -->
          <div class="pt-space-xs border-t border-border-subtle/40">
            <a
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-center gap-2 py-2 px-3 rounded-lg bg-surface-container-low hover:bg-surface-container border border-border-subtle/40 text-on-surface font-mono text-label-sm font-medium transition-colors"
            >
              <span class="material-symbols-outlined text-base text-on-surface">terminal</span>
              <span>Código fuente en GitHub ↗</span>
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>
